<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://apache.org"
         xmlns:xsi="http://w3.org"
         xsi:schemaLocation="http://apache.org https://apache.org">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.0</version>
        <relativePath/>
    </parent>

    <groupId>nl.commonground.poc</groupId>
    <artifactId>cg-nosql-poc</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Common Ground NoSQL PoC</name>
    <description>Shared Engine en Dedicated API's voor Common Ground registers</description>

    <modules>
        <module>cg-core-engine</module>
        <module>zaken-api</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <json-schema-validator.version>1.5.4</json-schema-validator.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Interne Shared Engine module -->
            <dependency>
                <groupId>nl.commonground.poc</groupId>
                <artifactId>cg-core-engine</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- JSON Schema Validator (Draft 2020-12 ondersteuning) -->
            <dependency>
                <groupId>com.networknt</groupId>
                <artifactId>json-schema-validator</artifactId>
                <version>${json-schema-validator.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
